# Superuser connection. Used only by `pnpm db:bootstrap` to create the roles and database.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# Owner role. Used only by migrations. Owns every table.
DATABASE_OWNER_URL=postgres://fxchange_owner:owner_dev_password@localhost:5432/fxchange

# Application role. Used by the web application and the worker.
# It is not a superuser and cannot bypass row-level security.
DATABASE_URL=postgres://fxchange_app:app_dev_password@localhost:5432/fxchange
